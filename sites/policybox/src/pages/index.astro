---
// Text and images: src/content/home.yaml
import { getEntry } from 'astro:content';
import Site from '../layouts/Site.astro';
import Hero from '@noirvision/ui/components/Hero.astro';
import Header from '@noirvision/ui/components/Header.astro';
import Section from '@noirvision/ui/components/Section.astro';
import SectionHeading from '@noirvision/ui/components/SectionHeading.astro';
import WaitlistForm from '@noirvision/ui/components/WaitlistForm.astro';
import FeatureCards from '@noirvision/ui/components/FeatureCards.astro';
import Steps from '@noirvision/ui/components/Steps.astro';
import FeatureRows from '@noirvision/ui/components/FeatureRows.astro';
import FeatureList from '@noirvision/ui/components/FeatureList.astro';
import CallToAction from '@noirvision/ui/components/CallToAction.astro';
import AudienceCards from '@noirvision/ui/components/AudienceCards.astro';
import Footer from '@noirvision/ui/components/Footer.astro';
import { richHtml } from '@noirvision/ui/content/html.ts';
import { brand, socials, footer } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('src/content/home.yaml is missing');
const { seo, hero, waitlist, why, howItWorks, features, alternateUses, whiteLabel, contact } = entry.data;

// Card sizes and entrance directions, by position (design, not content).
const whyLayout = [
  { bleed: 'bottom', reveal: 'left' },
  { reveal: 'up' },
  { bleed: 'bottom', span: { rows: 2 }, reveal: 'right' },
  { bleed: 'right', span: { cols: 2 }, reveal: 'left' },
] as const;
const stepWidths = [576, undefined, 527];
---

<Site title={seo.title} description={seo.description} ogImage={seo.socialImage} ogTitle={seo.socialTitle}>
  <Hero
    layout="split"
    titleMuted={hero.headingMuted}
    title={hero.heading}
    lead={hero.paragraphs}
    image={hero.image.src}
    imageAlt={hero.image.alt}
  >
    <Header slot="header" {...brand} socials={socials} bar reveal={{ delay: 100, logoDistance: 200 }} socialSizeSmall={24} />
  </Hero>

  <Section spacing="waitlist" id="waitlist">
    <WaitlistForm
      layout="inline"
      lead={waitlist.text}
      selectIcon={waitlist.dropdownIcon}
      selectPlaceholder={waitlist.dropdownPlaceholder}
      selectLabel={waitlist.dropdownLabel}
      options={waitlist.options.map((option) => ({ value: option, label: option }))}
      emailPlaceholder={waitlist.emailPlaceholder}
      buttonLabel={waitlist.button}
      successMessage={waitlist.successMessage}
      revealGroup={{ delay: 1200, offset: 0 }}
    >
      <Fragment slot="heading" set:html={richHtml(waitlist.heading)} />
    </WaitlistForm>
  </Section>

  <Section spacing="why">
    <FeatureCards
      label={why.listLabel}
      items={why.cards.map((card, i) => ({
        icon: card.icon,
        title: card.title,
        text: card.text,
        image: card.image.src,
        imageAlt: card.image.alt,
        ...whyLayout[i],
      }))}
    >
      <SectionHeading slot="heading" data-reveal="up"><Fragment set:html={richHtml(why.heading)} /></SectionHeading>
    </FeatureCards>
  </Section>

  <Steps
    layout="list"
    tone="plain"
    image={howItWorks.image.src}
    imageAlt={howItWorks.image.alt}
    steps={howItWorks.steps.map((step, i) => ({ ...step, textWidth: stepWidths[i] }))}
  >
    <Fragment slot="heading" set:html={richHtml(howItWorks.heading)} />
  </Steps>

  <FeatureRows
    variant="cards"
    imageWidth={620}
    rows={features.rows.map((row, i) => ({
      icon: row.icon,
      title: row.title,
      text: row.text,
      image: row.image.src,
      imageAlt: row.image.alt,
      flip: i % 2 === 1,
    }))}
  >
    <Fragment slot="heading" set:html={richHtml(features.heading)} />
  </FeatureRows>

  <FeatureList intro={alternateUses.paragraphs} items={alternateUses.items}>
    <Fragment slot="heading" set:html={richHtml(alternateUses.heading)} />
  </FeatureList>

  <CallToAction text={whiteLabel.text} button={whiteLabel.button}>
    <Fragment slot="heading" set:html={richHtml(whiteLabel.heading)} />
  </CallToAction>

  <Footer slot="footer" {...footer} frame reveal>
    <AudienceCards
      variant="glass"
      as="div"
      lead={contact.text}
      cards={contact.cards.map((card) => ({ icon: card.icon, title: card.title, text: card.text, cta: card.button }))}
    >
      <Fragment slot="heading" set:html={richHtml(contact.heading)} />
    </AudienceCards>
  </Footer>
</Site>
