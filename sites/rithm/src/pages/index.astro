---
// Text and images: src/content/home.yaml
import { getEntry } from 'astro:content';
import Site from '../layouts/Site.astro';
import Hero from '@noirvision/ui/components/Hero.astro';
import Header from '@noirvision/ui/components/Header.astro';
import Section from '@noirvision/ui/components/Section.astro';
import SectionHeading from '@noirvision/ui/components/SectionHeading.astro';
import WaitlistForm from '@noirvision/ui/components/WaitlistForm.astro';
import MediaText from '@noirvision/ui/components/MediaText.astro';
import FeatureCards from '@noirvision/ui/components/FeatureCards.astro';
import CallToAction from '@noirvision/ui/components/CallToAction.astro';
import Footer from '@noirvision/ui/components/Footer.astro';
import { richHtml } from '@noirvision/ui/content/html.ts';
import { brand, footer } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('src/content/home.yaml is missing');
const { seo, hero, solutions, features, understand, join } = entry.data;

const form = {
  emailPlaceholder: entry.data.form.emailPlaceholder,
  buttonLabel: entry.data.form.button,
  successMessage: entry.data.form.successMessage,
  reveal: false,
};
---

<Site title={seo.title} description={seo.description} ogImage={seo.socialImage} ogTitle={seo.socialTitle}>
  <Hero
    layout="split"
    visual="contained"
    tone="deep"
    mobileAlign="center"
    title={hero.heading}
    lead={hero.text}
    image={hero.image.src}
    imageAlt={hero.image.alt}
    reveal={{ copy: null, title: 600, lead: 900, content: 1200, visual: 1200 }}
  >
    <Header slot="brand" {...brand} reveal={{ delay: 300 }} />
    <WaitlistForm id="hero" {...form} />
  </Hero>

  <div class="glow-zone">
    <div class="glow glow-left" aria-hidden="true"></div>

    <Section spacing="solutions">
      <MediaText
        eyebrow={solutions.eyebrow}
        eyebrowIcon={solutions.eyebrowIcon}
        text={solutions.paragraphs}
        image={solutions.image.src}
        imageAlt={solutions.image.alt}
        imageWidth={650}
        revealOffset={25}
      >
        <Fragment slot="heading" set:html={richHtml(solutions.heading)} />
      </MediaText>
    </Section>

    <Section spacing="check">
      <FeatureCards
        label={features.listLabel}
        iconLayout="stacked"
        reveal={{ offset: 25, grid: 'fade', gridOffset: 20 }}
        items={features.cards}
      >
        <SectionHeading
          slot="heading"
          eyebrow={features.eyebrow}
          eyebrowIcon={features.eyebrowIcon}
          align="start"
          gap="md"
          data-reveal="left"
          data-reveal-offset="25"
        >
          <Fragment set:html={richHtml(features.heading)} />
        </SectionHeading>
      </FeatureCards>
    </Section>

    <Section spacing="understand">
      <MediaText
        flip
        eyebrow={understand.eyebrow}
        eyebrowIcon={understand.eyebrowIcon}
        text={understand.paragraphs}
        image={understand.image.src}
        imageAlt={understand.image.alt}
        imageWidth={525}
        backdrop={understand.backgroundImage}
        revealOffset={25}
      >
        <Fragment slot="heading" set:html={richHtml(understand.heading)} />
      </MediaText>
      <div class="glow glow-right" aria-hidden="true"></div>
    </Section>
  </div>

  <CallToAction
    layout="panel"
    reveal="left"
    text={join.text}
    image={join.image.src}
    imageAlt={join.image.alt}
    imageWidth={420}
  >
    <Fragment slot="heading" set:html={richHtml(join.heading)} />
    <WaitlistForm id="cta" {...form} />
  </CallToAction>

  <Footer slot="footer" {...footer} />
</Site>

<style>
  /* One-off decoration: two blurred lime glows behind the middle sections,
     as in the export (.glow-circle). */
  .glow-zone {
    position: relative;
  }

  .glow {
    position: absolute;
    z-index: -1;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: #cde9ab;
    filter: blur(150px);
    pointer-events: none;
  }

  .glow-left {
    top: 20%;
    left: -15%;
  }

  .glow-right {
    right: -10%;
    bottom: -15%;
  }

  @media (max-width: 479px) {
    .glow {
      display: none;
    }
  }
</style>
