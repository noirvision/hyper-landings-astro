---
// Text and images: src/content/home.yaml
import { getEntry } from 'astro:content';
import Site from '../layouts/Site.astro';
import Hero from '@noirvision/ui/components/Hero.astro';
import Header from '@noirvision/ui/components/Header.astro';
import Section from '@noirvision/ui/components/Section.astro';
import SectionHeading from '@noirvision/ui/components/SectionHeading.astro';
import WaitlistForm from '@noirvision/ui/components/WaitlistForm.astro';
import FeatureGrid from '@noirvision/ui/components/FeatureGrid.astro';
import Steps from '@noirvision/ui/components/Steps.astro';
import FeatureRows from '@noirvision/ui/components/FeatureRows.astro';
import AudienceCards from '@noirvision/ui/components/AudienceCards.astro';
import Footer from '@noirvision/ui/components/Footer.astro';
import { richHtml } from '@noirvision/ui/content/html.ts';
import { brand, socials, footer } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('src/content/home.yaml is missing');
const { seo, hero, waitlist, why, howItWorks, keyFeatures, joinUs } = entry.data;
---

<Site title={seo.title} description={seo.description} ogImage={seo.socialImage} ogTitle={seo.socialTitle}>
  <Hero title={hero.heading} lead={hero.text} image={hero.image.src} imageAlt={hero.image.alt}>
    <Header slot="header" {...brand} socials={socials} reveal />
  </Hero>

  <Section spacing="waitlist">
    <WaitlistForm
      options={waitlist.options.map((option) => ({ value: option, label: option }))}
      selectPlaceholder={waitlist.dropdownPlaceholder}
      selectLabel={waitlist.dropdownLabel}
      emailPlaceholder={waitlist.emailPlaceholder}
      buttonLabel={waitlist.button}
      successMessage={waitlist.successMessage}
    >
      <Fragment slot="heading" set:html={richHtml(waitlist.heading)} />
    </WaitlistForm>
    <div class="accent-rule" data-reveal="fade" data-reveal-offset="25"></div>
    <FeatureGrid
      label={why.listLabel}
      items={why.items.map((item) => ({ image: item.image.src, imageAlt: item.image.alt, title: item.title, text: item.text }))}
    >
      <SectionHeading slot="heading" data-reveal="up"><Fragment set:html={richHtml(why.heading)} /></SectionHeading>
    </FeatureGrid>
  </Section>

  <Steps steps={howItWorks.steps}>
    <Fragment slot="heading" set:html={richHtml(howItWorks.heading)} />
  </Steps>

  <FeatureRows
    rows={keyFeatures.rows.map((row, i) => ({
      title: row.title,
      lead: row.lead,
      text: row.text,
      image: row.image.src,
      imageAlt: row.image.alt,
      flip: i % 2 === 1,
    }))}
  >
    <Fragment slot="heading" set:html={richHtml(keyFeatures.heading)} />
  </FeatureRows>

  <AudienceCards cards={joinUs.cards}>
    <Fragment slot="heading" set:html={richHtml(joinUs.heading)} />
  </AudienceCards>

  <Footer slot="footer" {...footer} />
</Site>

<style>
  /* One-off decoration between the waitlist and "Why choose": a thick accent rule. */
  .accent-rule {
    max-width: 55.375rem;
    height: 0.75rem;
    margin: 0 auto 5.375rem;
    background: var(--ui-color-accent);
  }

  @media (max-width: 767px) {
    .accent-rule {
      display: none;
    }
  }
</style>
