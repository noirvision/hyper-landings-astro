---
import Site from '../layouts/Site.astro';
import Hero from '@noirvision/ui/components/Hero.astro';
import Header from '@noirvision/ui/components/Header.astro';
import Section from '@noirvision/ui/components/Section.astro';
import SectionHeading from '@noirvision/ui/components/SectionHeading.astro';
import WaitlistForm from '@noirvision/ui/components/WaitlistForm.astro';
import FeatureGrid from '@noirvision/ui/components/FeatureGrid.astro';
import Steps from '@noirvision/ui/components/Steps.astro';
import FeatureRows from '@noirvision/ui/components/FeatureRows.astro';
import AudienceCards from '@noirvision/ui/components/AudienceCards.astro';
import Footer from '@noirvision/ui/components/Footer.astro';
import { brand, socials, footer } from '../content';

import hero from '../assets/hero.avif';
import why1 from '../assets/why-01.avif';
import why2 from '../assets/why-02.avif';
import why3 from '../assets/why-03.avif';
import key1 from '../assets/key-01.avif';
import key2 from '../assets/key-02.avif';
import key3 from '../assets/key-03.png';
import iconUser from '../assets/icons/icon-01.svg';
import iconPartners from '../assets/icons/icon-02.svg';
import iconInvestor from '../assets/icons/icon-03.svg';
---

<Site title="oddAcademia" description="Where Deep Thinking Finds Its Voice.">
  <Hero
    title="The Home for Independent Research and Ideas"
    lead="Odd Academia is a platform empowering early-career researchers and independent thinkers to publish and share their work without restraint. Bypassing traditional gatekeeping, we bring fresh ideas and perspectives that are true to the scientific method directly to readers, evolving the way people consume and produce new knowledge."
    image={hero}
  >
    <Header slot="header" {...brand} socials={socials} reveal />
  </Hero>

  <Section spacing="waitlist">
    <WaitlistForm
      heading="Join the waitlist"
      options={[
        { value: 'User', label: 'User' },
        { value: 'Partner', label: 'Partner' },
        { value: 'Investor', label: 'Investor' },
      ]}
    />
    <div class="accent-rule" data-reveal="fade" data-reveal-offset="25"></div>
    <FeatureGrid
      label="Why choose Odd Academia"
      items={[
        {
          image: why1,
          title: 'Reach a Global Audience',
          text: 'Showcase your research without the constraints of traditional journals.',
        },
        {
          image: why2,
          title: 'Build Your Professional Profile',
          text: 'Gain credibility and career opportunities through a democratic review process.',
        },
        {
          image: why3,
          title: 'Break Free from Gatekeepers',
          text: 'Publish innovative work without restrictions or barriers.',
        },
      ]}
    >
      <SectionHeading slot="heading" data-reveal="up">Why <em>Choose</em> Odd Academia?</SectionHeading>
    </FeatureGrid>
  </Section>

  <Steps
    heading="How It Works"
    steps={[
      {
        title: 'Create a Profile',
        text: 'Build a professional profile that links to all your published work, showcasing your expertise and contributions.',
      },
      {
        title: 'Publish and Share',
        text: 'Upload your research, which will be distributed directly to readers around the world.',
      },
      {
        title: 'Receive Peer Validation',
        text: 'Connect with a global community of independent thinkers and researchers who can engage with and validate your work.',
      },
    ]}
  />

  <FeatureRows
    heading="Key Features"
    rows={[
      {
        title: 'Reach Key Audiences',
        lead: 'Gain Visibility Beyond Traditional Platforms.',
        text: 'Odd Academia lets you bypass conventional publishing channels and reach readers globally, allowing your work without gatekeeping to connect with the right people.',
        image: key1,
      },
      {
        title: 'Build Your Professional Profile',
        lead: 'Enhance Your Career Through Peer Validation',
        text: 'With each publication, strengthen your professional portfolio and build credibility through community-driven reviews, showcasing your expertise to future employers and collaborators.',
        image: key2,
        flip: true,
      },
      {
        title: 'A Platform for Innovators',
        lead: 'Freedom to Share Ideas and Break Barriers',
        text: 'Odd Academia is a home for bold ideas and innovation, providing a publishing space for those with fresh insights and unconventional approaches to research.',
        image: key3,
      },
    ]}
  />

  <AudienceCards
    heading="Join us"
    cards={[
      {
        icon: iconUser,
        title: 'For User',
        text: 'Ready to share your ideas with the world? Join Odd Academia and publish your work without limits.',
      },
      {
        icon: iconPartners,
        title: 'For Partners',
        text: 'Collaborate with us to transform academic publishing and bring fresh voices to the forefront.',
      },
      {
        icon: iconInvestor,
        title: 'For Investor',
        text: 'Help us build a future where independent research thrives.',
      },
    ]}
  />

  <Footer slot="footer" {...footer} />
</Site>

<style>
  /* One-off decoration between the waitlist and "Why choose": a thick accent rule. */
  .accent-rule {
    max-width: 55.375rem;
    height: 0.75rem;
    margin: 0 auto 5.375rem;
    background: var(--ui-color-accent);
  }

  @media (max-width: 767px) {
    .accent-rule {
      display: none;
    }
  }
</style>
