---
import LegalLayout from '@noirvision/ui/layouts/LegalLayout.astro';
import { preloadFonts } from './fonts';
import { brand, footer, head } from '../content';
import '../theme.css';

interface Props {
  title: string;
}
---

<LegalLayout {...head} title={Astro.props.title} preloadFonts={preloadFonts} header={brand} footer={{ ...footer, socials: footer.socials }}>
  <slot />
</LegalLayout>
