---
/**
 * Waitlist form: optional "I am a" dropdown + email + button, in one white bar
 * on desktop and stacked fields on mobile. `options` omitted = single-field
 * variant (email + button).
 *
 * layout      separate (button next to the bar) | inline (button inside the bar)
 * heading     plain-text title; or pass a `heading` slot for markup (<em>)
 * lead        line under the heading
 * selectIcon  icon drawn at the start of the dropdown
 * revealGroup reveal heading, lead and form as one block ({ delay, offset }),
 *             instead of the heading and the form separately
 *
 * The bar, fields and button are sized by tokens (--ui-field-*, --ui-select-*,
 * --ui-waitlist-*), defaults in the style block.
 *
 * The dropdown is a native <select>: the placeholder option is not selectable,
 * `required` makes the browser ask for a choice. Where the browser supports
 * customisable selects (appearance: base-select) the open list is styled too.
 * Submitting sends nothing yet (see scripts/form.ts); the success message
 * replaces the form.
 */
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  heading?: string;
  lead?: string;
  /** Dropdown options; omit for the single-field variant. */
  options?: Option[];
  selectPlaceholder?: string;
  /** Accessible label for the dropdown. */
  selectLabel?: string;
  selectName?: string;
  selectIcon?: ImageMetadata;
  emailPlaceholder?: string;
  emailLabel?: string;
  buttonLabel?: string;
  successMessage?: string;
  /** Unique prefix for field ids when a page has more than one form. */
  id?: string;
  layout?: 'separate' | 'inline';
  revealGroup?: { delay?: number; offset?: number };
}

const {
  heading,
  lead,
  options,
  selectPlaceholder = "I'm a",
  selectLabel = 'I am a',
  selectName = 'role',
  selectIcon,
  emailPlaceholder = 'Insert your email',
  emailLabel = 'Email',
  buttonLabel = 'Join Waitlist',
  successMessage = 'Thank you! Your submission has been received!',
  id = 'waitlist',
  layout = 'separate',
  revealGroup,
} = Astro.props;
const single = !options?.length;
const inline = layout === 'inline';
const hasHeading = heading || Astro.slots.has('heading');
const group = revealGroup
  ? {
      'data-reveal': 'up',
      'data-reveal-offset': String(revealGroup.offset ?? 20),
      style: `--ui-reveal-delay:${revealGroup.delay ?? 0}ms`,
    }
  : {};
---

<div class="group" {...group}>
  {
    hasHeading && (
      <SectionHeading gap="sm" mobileSize="sm" data-reveal="up">
        {Astro.slots.has('heading') ? <slot name="heading" /> : heading}
      </SectionHeading>
    )
  }
  {lead && <p class="lead">{lead}</p>}
  <div class:list={['waitlist', `layout-${layout}`, { single }]} data-ui-waitlist {...(revealGroup ? {} : { 'data-reveal': 'up' })}>
    <form class="form">
      <div class="bar">
        {
          !single && (
            <div class:list={['select-wrap', { 'has-icon': selectIcon }]}>
              {selectIcon && <img class="select-icon" src={selectIcon.src} width={selectIcon.width} height={selectIcon.height} alt="" />}
              <label class="ui-visually-hidden" for={`${id}-select`}>{selectLabel}</label>
              <select id={`${id}-select`} name={selectName} required autocomplete="off" data-ui-select data-empty="true" class="select">
                <option value="" disabled selected hidden>{selectPlaceholder}</option>
                {options!.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            </div>
          )
        }
        <div class="email-wrap">
          <svg class="mail" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
              d="M2.5 5.42c0-.92.75-1.67 1.67-1.67h11.66c.92 0 1.67.75 1.67 1.67v9.16c0 .92-.75 1.67-1.67 1.67H4.17c-.92 0-1.67-.75-1.67-1.67z"
            />
            <path stroke="currentColor" stroke-linecap="round" stroke-width="1.7" d="m5.42 7.08 3.6 2.62a1.67 1.67 0 0 0 1.96 0l3.6-2.62" />
          </svg>
          <label class="ui-visually-hidden" for={`${id}-email`}>{emailLabel}</label>
          <input id={`${id}-email`} class="email" type="email" name="email" maxlength="256" placeholder={emailPlaceholder} autocomplete="email" required />
        </div>
        {inline && <Button type="submit" class="submit">{buttonLabel}</Button>}
      </div>
      {!inline && <Button type="submit" class="submit">{buttonLabel}</Button>}
    </form>
    <div class="success" data-ui-waitlist-success tabindex="-1" role="status" hidden>
      {successMessage}
    </div>
  </div>
</div>

<script>
  import '../scripts/select.ts';
  import '../scripts/form.ts';
</script>

<style>
  .lead {
    margin: 0 0 var(--ui-waitlist-lead-gap, 2.5rem);
    font-size: var(--ui-font-size-body);
    text-align: center;
    opacity: var(--ui-color-text-muted-opacity);
  }

  .waitlist {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--ui-waitlist-max, 45.625rem);
    margin: 0 auto var(--ui-waitlist-margin-bottom, 3.25rem);
    color: var(--ui-color-field-text);
    font-size: var(--ui-field-font-size, var(--ui-size-xs));
  }

  .waitlist.single {
    max-width: 37.5rem;
    margin-bottom: 0;
  }

  .form {
    display: flex;
    gap: 1rem;
    align-items: stretch;
    height: var(--ui-field-height, 4.125rem);
    --ui-button-height: 100%;
    --ui-button-weight: var(--ui-waitlist-button-weight, var(--ui-font-weight-button));
  }

  .bar {
    display: flex;
    flex: 1;
    align-items: center;
    border: var(--ui-field-border, 0);
    background: var(--ui-color-field);
    border-radius: var(--ui-radius-control);
  }

  .layout-inline .bar {
    gap: 1.5rem;
  }

  .select-wrap {
    position: relative;
    display: flex;
    flex: none;
    height: calc(var(--ui-field-height, 4.125rem) - 4px);
    padding-right: 20px;
  }

  .layout-inline .select-wrap {
    padding-right: 0;
  }

  .select-icon {
    position: absolute;
    top: 50%;
    left: 24px;
    z-index: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* Chevron, drawn like the original: a rotated 2px corner. */
  .select-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    right: var(--ui-select-chevron-right, 45px);
    box-sizing: content-box;
    width: 5px;
    height: 5px;
    margin-top: -4px;
    border-right: 2px solid var(--ui-select-chevron-color, var(--ui-color-field-text));
    border-bottom: 2px solid var(--ui-select-chevron-color, var(--ui-color-field-text));
    transform: rotate(45deg);
    transform-origin: 66% 66%;
    pointer-events: none;
    transition: transform 0.15s ease-in-out;
  }

  .select-wrap:has(.select:open)::after {
    transform: rotate(-135deg);
  }

  .select {
    appearance: none;
    width: var(--ui-select-width, 117px);
    min-width: var(--ui-select-min-width, 0);
    height: 100%;
    margin: 0;
    padding: 0 var(--ui-select-pad-end, 40px) 0 24px;
    border: 0;
    border-radius: var(--ui-radius-control) 0 0 var(--ui-radius-control);
    background: var(--ui-color-field);
    color: var(--ui-color-field-text);
    font-size: var(--ui-field-font-size, var(--ui-size-xs));
    letter-spacing: var(--ui-select-letter-spacing, -0.03em);
    cursor: pointer;
  }

  .has-icon .select {
    padding-left: 3.625rem;
  }

  .email-wrap {
    position: relative;
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    margin-right: 1rem;
    color: var(--ui-color-field-icon);
  }

  .layout-inline .email-wrap {
    margin-right: 0;
  }

  /* Divider between dropdown and email, then the envelope. */
  .email-wrap::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 42px;
    margin-top: -21px;
    background: var(--ui-color-field-divider);
  }

  .single .email-wrap::before {
    display: none;
  }

  .mail {
    position: absolute;
    left: 25px;
    opacity: var(--ui-field-icon-opacity, 0.85);
    pointer-events: none;
  }

  .email {
    width: 100%;
    height: 100%;
    padding: 0 12px 0 4.5rem;
    border: 0;
    border-radius: 0 var(--ui-radius-control) var(--ui-radius-control) 0;
    background: transparent;
    color: var(--ui-color-field-text);
    font-size: var(--ui-field-font-size, var(--ui-size-xs));
    line-height: 1;
  }

  .single .email {
    border-radius: var(--ui-radius-control);
  }

  .email::placeholder {
    color: var(--ui-color-field-text);
    opacity: 1;
  }

  .email:focus,
  .select:focus {
    outline: none;
  }

  .email:focus-visible,
  .select:focus-visible {
    outline: 2px solid var(--ui-color-field-focus);
    outline-offset: -2px;
  }

  /* Button inside the bar, inset evenly from its edge. */
  .layout-inline .form :global(.submit) {
    align-self: center;
    height: calc(var(--ui-field-height, 4.125rem) - 12px);
    margin-right: 6px;
  }

  .success {
    padding: 20px;
    border-radius: var(--ui-radius-card);
    background: var(--ui-color-success-bg);
    color: var(--ui-color-success-text);
    font-size: var(--ui-size-body, 1rem);
    text-align: center;
  }

  .success[hidden],
  .form[hidden] {
    display: none;
  }

  /* Customisable select (Chromium 135+): style the open list like the original
     nice-select menu. Other browsers keep their native list. */
  @supports (appearance: base-select) {
    .select,
    .select::picker(select) {
      appearance: base-select;
    }

    .select {
      display: flex;
      align-items: center;
    }

    .select::picker-icon {
      display: none;
    }

    .select::picker(select) {
      margin-top: 4px;
      padding: 10px 0;
      border: 0;
      border-radius: 5px;
      background: var(--ui-color-menu);
      box-shadow: var(--ui-shadow-menu);
      color: var(--ui-color-field-text);
      opacity: 0;
      transform: scale(0.75) translateY(-21px);
      transform-origin: 50% 0;
      transition:
        transform 0.2s cubic-bezier(0.5, 0, 0, 1.25),
        opacity 0.15s ease-out,
        overlay 0.2s allow-discrete,
        display 0.2s allow-discrete;
    }

    .select:open::picker(select) {
      opacity: 1;
      transform: none;
    }

    @starting-style {
      .select:open::picker(select) {
        opacity: 0;
        transform: scale(0.75) translateY(-21px);
      }
    }

    .select option {
      min-height: 40px;
      padding: 0 18px;
      line-height: 40px;
      cursor: pointer;
    }

    .select option::checkmark {
      display: none;
    }

    .select option:hover,
    .select option:focus-visible {
      background: var(--ui-color-menu-hover);
      outline: none;
    }

    .select option:checked {
      font-weight: 700;
    }
  }

  @media (max-width: 767px) {
    .lead {
      font-size: var(--ui-size-small);
    }

    .form {
      flex-direction: column;
      gap: var(--ui-field-gap-mobile, 8px);
      height: auto;
      --ui-button-height: var(--ui-field-height-mobile, 40px);
      --ui-button-radius: 8px;
    }

    .bar {
      flex-direction: column;
      align-items: stretch;
      border: 0;
      background: transparent;
      border-radius: 0;
    }

    .layout-inline .bar {
      gap: var(--ui-field-gap-mobile, 8px);
    }

    .select-wrap {
      width: 100%;
      height: var(--ui-field-height-mobile, 40px);
      margin-bottom: 8px;
      padding-right: 0;
      border: var(--ui-field-border, 0);
      border-radius: 8px;
      background: var(--ui-color-field);
    }

    .layout-inline .select-wrap {
      margin-bottom: 0;
    }

    .select-wrap::after {
      right: 25px;
    }

    .select {
      flex: 1;
      width: 100%;
      border-radius: 8px;
    }

    .email-wrap {
      flex: none;
      height: var(--ui-field-height-mobile, 40px);
      margin-right: 0;
      border: var(--ui-field-border, 0);
      border-radius: 8px;
      background: var(--ui-color-field);
    }

    .email-wrap::before {
      display: none;
    }

    .mail {
      left: var(--ui-field-icon-left-mobile, 16px);
      color: var(--ui-color-field-icon-mobile, #0b2d39);
      opacity: var(--ui-field-icon-opacity-mobile, 0.6);
    }

    .email {
      padding-left: var(--ui-email-pad-mobile, 4.5rem);
      border-radius: 8px;
    }

    .layout-inline .form :global(.submit) {
      align-self: stretch;
      height: var(--ui-field-height-mobile, 40px);
      margin-right: 0;
    }
  }

  @media (max-width: 479px) {
    .form {
      --ui-button-radius: var(--ui-radius-control-sm);
      --ui-button-pad-x: 30px;
    }

    .select {
      padding-left: 16px;
      border-radius: var(--ui-radius-control-sm);
      font-size: var(--ui-select-font-size-small, var(--ui-size-small));
    }

    .has-icon .select {
      padding-left: 3.625rem;
    }

    .select-wrap,
    .email-wrap,
    .email {
      border-radius: var(--ui-radius-control-sm);
    }

    .mail {
      display: var(--ui-email-icon-small, block);
    }

    .email {
      padding-left: var(--ui-email-pad-small, var(--ui-email-pad-mobile, 4.5rem));
      font-size: var(--ui-field-font-size-small, var(--ui-field-font-size, var(--ui-size-xs)));
    }
  }
</style>
