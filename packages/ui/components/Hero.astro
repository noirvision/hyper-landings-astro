---
/**
 * Hero with a product visual on an accent (or deep) panel, header slot on top.
 *
 * layout="centered" (default): centred title + lead, then a large screenshot
 *   that bleeds off the bottom edge. The whole panel fades in, then title,
 *   lead and visual rise in turn.
 * layout="split": title and lead on the left, the visual on the right,
 *   bleeding off the right and bottom edges (the image itself carries any
 *   perspective). Copy slides in from the left, the visual from the right.
 *   Sized by --ui-hero-copy-width and --ui-hero-visual-height(-tablet/-small).
 *   visual="contained": the visual is not bled off the edges but centred in
 *   its column at `imageWidth` (e.g. a phone mockup over a backdrop photo).
 *   Grid and spacing tokens: --ui-hero-gap(-tablet/-small), --ui-hero-grid-mb
 *   (-mobile), --ui-hero-copy-max, --ui-hero-brand-gap(-tablet),
 *   --ui-hero-title-gap(-mobile/-small), --ui-hero-content-gap,
 *   --ui-hero-lead-size(-mobile), --ui-space-hero-top-tablet,
 *   --ui-hero-copy-offset-small (space above the copy at ≤479px).
 *   mobileAlign="center": at ≤767px the copy column is centred (brand,
 *   title, form); lead text follows --ui-hero-lead-align-mobile / -small.
 *   reveal: override the split choreography's delays in ms
 *   ({ copy, title, lead, content, visual }); copy: null = no reveal on the
 *   whole column; content = the default slot (e.g. a form), off by default.
 *
 * titleMuted  optional opening words of the title in --ui-hero-title-muted
 *             (e.g. "Decisions" + "made simple"); the title wraps naturally,
 *             and on phones (≤479px) the muted words take their own line.
 * lead        one paragraph, or several (on phones the first can be set
 *             smaller with --ui-hero-first-lead-size-small).
 *
 * Slots: header (usually <Header>; the top row is only rendered when given),
 * brand (split: content above the title in the copy column, e.g. <Header>
 * with just the logo), default (optional extra content under the lead, e.g.
 * a waitlist form). Title colour: --ui-color-heading.
 * The backdrop layer (--ui-hero-backdrop) shows on desktop; below 992px
 * --ui-hero-backdrop-tablet (default none) replaces it.
 */
import type { ImageMetadata } from 'astro';
import Image from './Image.astro';

interface Props {
  title: string;
  titleMuted?: string;
  lead?: string | string[];
  image: ImageMetadata;
  imageAlt?: string;
  /** Rendered width of the visual in px (desktop). */
  imageWidth?: number;
  imageSizes?: string;
  tone?: 'accent' | 'deep';
  layout?: 'centered' | 'split';
  /** split: bleed the visual off the edges (default) or centre it in its column. */
  visual?: 'bleed' | 'contained';
  mobileAlign?: 'start' | 'center';
  /** split: reveal delays in ms; copy: null turns the column's own reveal off. */
  reveal?: { copy?: number | null; title?: number; lead?: number; content?: number; visual?: number };
}

const {
  title,
  titleMuted,
  lead,
  image,
  imageAlt = '',
  tone = 'accent',
  layout = 'centered',
  visual = 'bleed',
  mobileAlign = 'start',
  reveal: delays = {},
} = Astro.props;
const split = layout === 'split';
const contained = split && visual === 'contained';
const imageWidth = Astro.props.imageWidth ?? (contained ? 266 : split ? 1652 : 962);
const imageSizes =
  Astro.props.imageSizes ??
  (contained
    ? `${imageWidth}px`
    : split
      ? `(max-width: 767px) 150vw, (max-width: 991px) 160vw, ${imageWidth}px`
      : '(max-width: 479px) 83vw, (max-width: 767px) 89vw, (max-width: 1045px) 92vw, 962px');
const leads = lead ? (Array.isArray(lead) ? lead : [lead]) : [];
const widths = contained
  ? [imageWidth, Math.round(imageWidth * 1.5), imageWidth * 2]
  : split
    ? [800, 1200, imageWidth, Math.round(imageWidth * 1.5), imageWidth * 2]
    : [480, 800, imageWidth, Math.round(imageWidth * 1.5)];
const hasHeader = Astro.slots.has('header');
const hasBrand = split && Astro.slots.has('brand');
const hasContent = Astro.slots.has('default');
type Motion = [string, number] | null;
const step = (dir: string, fallback: Motion, delay: number | null | undefined): Motion =>
  delay === null ? null : delay === undefined ? fallback : [dir, delay];
// Reveal choreography per layout: [attribute, delay ms].
const motion: Record<string, Motion> = split
  ? {
      section: null,
      copy: step('left', ['left', 300], delays.copy),
      title: step('left', ['left', 400], delays.title),
      lead: step('left', ['left', 700], delays.lead),
      content: step('left', null, delays.content),
      visual: step('right', ['right', 1000], delays.visual),
    }
  : { section: ['fade', 100], copy: null, title: ['up', 600], lead: ['up', 900], content: null, visual: ['up', 1200] };
const reveal = (m: Motion) =>
  m ? { 'data-reveal': m[0], 'data-reveal-offset': '0', style: `--ui-reveal-delay:${m[1]}ms` } : {};
---

<section
  class:list={['hero', `tone-${tone}`, `layout-${layout}`, { 'visual-contained': contained, 'align-mobile-center': mobileAlign === 'center' }]}
  {...reveal(motion.section)}
>
  {
    (!split || hasHeader) && (
      <div class:list={['container', { 'top-container': split }]}>
        <div class="top"><slot name="header" /></div>
        {!split && (
          <div class="copy">
            <h1 class="title" {...reveal(motion.title)}>
              {titleMuted && <span class="muted">{titleMuted} </span>}
              {title}
            </h1>
            {leads.map((p) => <p class="lead" {...reveal(motion.lead)}>{p}</p>)}
            <slot />
          </div>
        )}
        {!split && (
          <div class="visual" {...reveal(motion.visual)}>
            <Image src={image} alt={imageAlt} width={imageWidth} widths={widths} sizes={imageSizes} priority class="shot" />
          </div>
        )}
      </div>
    )
  }
  {
    split && (
      <div class="container">
        <div class="grid">
          <div class="copy" {...reveal(motion.copy)}>
            {
              hasBrand && (
                <div class="brand-slot">
                  <slot name="brand" />
                </div>
              )
            }
            <h1 class="title" {...reveal(motion.title)}>
              {titleMuted && <span class="muted">{titleMuted} </span>}
              {title}
            </h1>
            {leads.map((p) => <p class="lead" {...reveal(motion.lead)}>{p}</p>)}
            {
              hasContent && (
                <div class="content" {...reveal(motion.content)}>
                  <slot />
                </div>
              )
            }
          </div>
          <div class="visual" {...reveal(motion.visual)}>
            <Image src={image} alt={imageAlt} width={imageWidth} widths={widths} sizes={imageSizes} priority class="shot" />
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero {
    margin: var(--ui-margin-hero, var(--ui-panel-gap-y) var(--ui-panel-gap-x));
    padding-top: var(--ui-space-hero-top, 2rem);
    overflow: hidden;
    border-radius: var(--ui-radius-hero, var(--ui-radius-panel));
  }

  .tone-accent {
    background: var(--ui-hero-backdrop), var(--ui-bg-accent);
    color: var(--ui-color-on-accent);
  }

  .tone-deep {
    background: var(--ui-hero-backdrop), var(--ui-bg-deep);
    color: var(--ui-color-on-deep);
  }

  .container {
    max-width: var(--ui-container-max);
    margin-inline: auto;
    padding-inline: var(--ui-container-pad);
  }

  .title {
    color: var(--ui-color-heading);
    font-size: var(--ui-size-h1);
    font-weight: var(--ui-hero-title-weight, var(--ui-font-weight-heading));
    line-height: var(--ui-hero-title-line-height, 1.5);
    letter-spacing: var(--ui-heading-letter-spacing);
  }

  .muted {
    color: var(--ui-hero-title-muted, rgb(255 255 255 / 0.6));
  }

  .lead {
    color: var(--ui-hero-lead-color, currentColor);
  }

  .visual {
    position: relative;
  }

  /* ---------- Centered ---------- */
  .layout-centered .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .layout-centered .top {
    width: 100%;
    max-width: 1300px;
    margin-bottom: 1.125rem;
    padding-block: 3rem 2.8125rem;
  }

  .layout-centered .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3.5625rem;
    padding-inline: 2rem;
  }

  .layout-centered .title {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .layout-centered .lead {
    max-width: 62.9375rem;
    margin: 0;
    font-size: var(--ui-size-lead);
    line-height: 1.6;
    text-align: center;
  }

  .layout-centered .visual {
    bottom: -10px;
    max-width: 100%;
  }

  .layout-centered .visual :global(.shot) {
    border-radius: var(--ui-radius-image) var(--ui-radius-image) 0 0;
  }

  /* ---------- Split ---------- */
  .layout-split {
    padding-bottom: 0;
  }

  .top-container {
    padding-inline: 0;
  }

  .layout-split .top {
    margin-bottom: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: var(--ui-hero-copy-width, 31rem) 1fr;
    gap: var(--ui-hero-gap, 5rem);
    align-items: center;
    margin-bottom: var(--ui-hero-grid-mb, 4rem);
  }

  .layout-split .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: var(--ui-hero-copy-max, none);
  }

  .brand-slot {
    align-self: stretch;
    margin-bottom: var(--ui-hero-brand-gap, 2rem);
  }

  .layout-split .title {
    margin: 0 0 var(--ui-hero-title-gap, 2rem);
  }

  .layout-split .lead {
    margin: 0;
    font-size: var(--ui-hero-lead-size, var(--ui-font-size-body));
    line-height: 1.5;
    letter-spacing: var(--ui-lead-letter-spacing, normal);
  }

  .content {
    align-self: stretch;
    margin-top: var(--ui-hero-content-gap, 0);
  }

  .layout-split .lead + .lead {
    margin-top: 0.75rem;
  }

  .layout-split .visual {
    align-self: start;
    min-height: var(--ui-hero-visual-height, 36rem);
  }

  .layout-split .visual :global(.picture) {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    max-width: none;
  }

  /* Contained visual: centred in its column at its own width. */
  .layout-split.visual-contained .visual {
    align-self: center;
    justify-self: center;
    min-height: 0;
  }

  .layout-split.visual-contained .visual :global(.picture) {
    position: static;
    width: auto;
    max-width: 100%;
  }

  @media (max-width: 991px) {
    .hero {
      padding-top: var(--ui-space-hero-top-tablet, var(--ui-space-hero-top, 2rem));
    }

    .brand-slot {
      margin-bottom: var(--ui-hero-brand-gap-tablet, var(--ui-hero-brand-gap, 2rem));
    }

    .hero.tone-accent {
      background: var(--ui-hero-backdrop-tablet, none), var(--ui-bg-accent);
    }

    .hero.tone-deep {
      background: var(--ui-hero-backdrop-tablet, none), var(--ui-bg-deep);
    }

    .layout-centered .copy {
      padding-bottom: 40px;
    }

    .top-container {
      padding-inline: var(--ui-container-pad);
    }

    .layout-split .top {
      margin-bottom: 2rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--ui-hero-gap-tablet, 0);
    }

    .layout-split .visual {
      min-height: var(--ui-hero-visual-height-tablet, 24rem);
    }

    .layout-split .visual :global(.picture) {
      width: var(--ui-hero-visual-scale-tablet, 160%);
    }

    .layout-split.visual-contained .visual {
      min-height: 0;
    }

    .layout-split.visual-contained .visual :global(.picture) {
      width: auto;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: var(--ui-space-hero-top-mobile, 1rem);
    }

    .title {
      font-size: var(--ui-size-h1-mobile);
      line-height: var(--ui-hero-title-line-height-mobile, 1.4);
      text-align: left;
    }

    .layout-centered .top {
      margin-bottom: 0;
      padding-block: 0 3.125rem;
    }

    .layout-centered .copy {
      align-items: flex-start;
      margin-bottom: 0;
      padding: 0 0 5.375rem;
    }

    .layout-centered .title {
      text-align: left;
    }

    .layout-centered .lead {
      font-size: var(--ui-size-xs);
      text-align: left;
    }

    .layout-split .top {
      margin-bottom: 0;
    }

    .grid {
      margin-bottom: var(--ui-hero-grid-mb-mobile, 0);
    }

    .layout-split .title {
      margin-bottom: var(--ui-hero-title-gap-mobile, 1.5rem);
    }

    .layout-split .lead {
      font-size: var(--ui-hero-lead-size-mobile, var(--ui-size-small));
    }

    .layout-split .visual :global(.picture) {
      width: var(--ui-hero-visual-scale-mobile, 150%);
    }

    .layout-split.visual-contained .visual :global(.picture) {
      width: auto;
    }

    /* Centred copy on phones: brand, title and form centred, the column too. */
    .align-mobile-center .copy {
      align-items: center;
      justify-self: center;
    }

    .align-mobile-center .title {
      text-align: center;
    }

    .align-mobile-center .lead {
      text-align: var(--ui-hero-lead-align-mobile, start);
    }
  }

  @media (max-width: 479px) {
    .hero {
      padding-top: var(--ui-space-hero-top-small, var(--ui-space-hero-top-mobile, 1rem));
    }

    .layout-split .container {
      padding-inline: var(--ui-container-pad-sm);
    }

    .layout-split .top-container {
      padding-inline: 1rem;
    }

    .title {
      font-size: var(--ui-size-h1-small, var(--ui-size-h1-mobile));
      line-height: var(--ui-hero-title-line-height-small, 1.2);
    }

    .layout-centered .copy {
      margin-bottom: 20px;
      padding-bottom: 0;
    }

    .layout-centered .visual :global(.shot) {
      border-radius: var(--ui-radius-image-sm) var(--ui-radius-image-sm) 0 0;
    }

    .grid {
      gap: var(--ui-hero-gap-small, 2.5rem);
    }

    .align-mobile-center .lead {
      text-align: var(--ui-hero-lead-align-small, var(--ui-hero-lead-align-mobile, start));
    }

    .layout-split .copy {
      margin-top: var(--ui-hero-copy-offset-small, 1.5rem);
    }

    /* On phones the muted words always get their own line. */
    .muted {
      display: block;
    }

    .layout-split .lead:first-of-type {
      font-size: var(--ui-hero-first-lead-size-small, var(--ui-size-small));
    }

    .layout-split .title {
      margin-bottom: var(--ui-hero-title-gap-small, 1rem);
    }

    .layout-split .visual {
      min-height: var(--ui-hero-visual-height-small, 14rem);
    }

    .layout-split .visual :global(.picture) {
      left: 16px;
    }

    .layout-split.visual-contained .visual :global(.picture) {
      left: auto;
    }
  }
</style>
