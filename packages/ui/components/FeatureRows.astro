---
/**
 * Alternating feature rows: text beside an image. `flip` puts the image on
 * the left on desktop. Below 992px every row stacks text first, then image.
 *
 * variant  rules (default): rows separated by thin rules, heading left.
 *          cards: every row is a tinted card (--ui-feature-card-fill,
 *          --ui-feature-card-border, artwork --ui-feature-card-art /
 *          --ui-feature-card-art-flip on desktop), optional icon above the
 *          title, image flush with the card's bottom edge; heading centred.
 *
 * heading may be replaced by a `heading` slot (for <em> markup).
 */
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Image from './Image.astro';

interface Row {
  icon?: ImageMetadata;
  title: string;
  /** Short line under the title. */
  lead?: string;
  /** Body text; a newline becomes a line break. */
  text: string;
  image: ImageMetadata;
  imageAlt?: string;
  flip?: boolean;
}

interface Props {
  heading?: string;
  rows: Row[];
  tone?: 'plain' | 'accent' | 'deep';
  imageWidth?: number;
  variant?: 'rules' | 'cards';
}

const { heading, rows, tone = 'plain', imageWidth = 530, variant = 'rules' } = Astro.props;
const cards = variant === 'cards';
const sizes = cards ? `(max-width: 991px) 90vw, ${imageWidth}px` : `(max-width: 767px) 83vw, ${imageWidth}px`;
---

<Section tone={tone} spacing="features" class={`variant-${variant}`}>
  <SectionHeading
    align={cards ? 'center' : 'start-center'}
    mobileSize={cards ? 'md' : 'lg'}
    gap={cards ? 'xl' : 'lg'}
    data-reveal="up"
  >
    {Astro.slots.has('heading') ? <slot name="heading" /> : heading}
  </SectionHeading>
  {
    rows.map((row) => (
      <div class:list={['row', { flip: row.flip }]}>
        <div class="text" data-reveal={row.flip ? 'right' : 'left'}>
          {row.icon && <img class="icon" src={row.icon.src} width={row.icon.width} height={row.icon.height} alt="" loading="lazy" />}
          <div>
            <h3 class="title">{row.title}</h3>
            {row.lead && <p class="lead">{row.lead}</p>}
            <p class="body">{row.text.split('\n').map((line, i) => (i ? [<br />, line] : line))}</p>
          </div>
        </div>
        <div class="media" data-reveal={row.flip ? 'left' : 'right'}>
          <Image
            src={row.image}
            alt={row.imageAlt}
            width={imageWidth}
            widths={[400, imageWidth, Math.round(imageWidth * 1.5), imageWidth * 2]}
            sizes={sizes}
          />
        </div>
      </div>
    ))
  }
</Section>

<style>
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ui-grid-gap);
  }

  .row + .row {
    margin-top: calc(2.5rem * 2 + 1px);
    position: relative;
  }

  .row + .row::before {
    content: '';
    position: absolute;
    top: calc(-2.5rem - 1px);
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ui-color-divider);
  }

  .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 33.125rem;
    justify-self: start;
  }

  .media {
    position: relative;
    justify-self: end;
    align-self: center;
  }

  .flip .text {
    grid-area: 1 / 2;
    justify-self: end;
  }

  .flip .media {
    grid-area: 1 / 1;
    justify-self: start;
  }

  :global(.variant-rules) .text > div {
    display: contents;
  }

  .title {
    margin: 0 0 1.5rem;
    font-size: var(--ui-size-heading-lg);
    line-height: 1.25;
  }

  .lead {
    margin: 0 0 0.5rem;
    font-size: var(--ui-size-lead);
    font-weight: var(--ui-font-weight-medium);
  }

  .body {
    margin: 0;
    font-size: var(--ui-size-lead);
    opacity: var(--ui-color-text-muted-opacity);
  }

  /* ---------- Cards ---------- */
  :global(.variant-cards) .row {
    grid-template-columns: 1fr auto;
    gap: 4.375rem;
    padding: 2.5rem 2.5rem 0;
    border: 1px solid var(--ui-feature-card-border, var(--ui-color-divider));
    border-radius: var(--ui-radius-card);
    background: var(--ui-feature-card-art, none), var(--ui-feature-card-fill, transparent);
  }

  :global(.variant-cards) .row.flip {
    grid-template-columns: auto 1fr;
    background: var(--ui-feature-card-art-flip, none), var(--ui-feature-card-fill, transparent);
  }

  :global(.variant-cards) .row + .row {
    margin-top: 1.5rem;
  }

  :global(.variant-cards) .row + .row::before {
    display: none;
  }

  :global(.variant-cards) .text {
    gap: 2rem;
    align-self: center;
    justify-self: stretch;
    max-width: none;
    margin-bottom: 2.5rem;
  }

  :global(.variant-cards) .flip .text {
    justify-self: stretch;
  }

  :global(.variant-cards) .icon {
    display: block;
  }

  :global(.variant-cards) .title {
    margin-bottom: 0.75rem;
    font-size: var(--ui-feature-card-title-size, var(--ui-size-title));
    line-height: 1.2;
  }

  :global(.variant-cards) .body {
    font-size: var(--ui-font-size-body);
  }

  :global(.variant-cards) .media {
    align-self: end;
  }

  @media (max-width: 991px) {
    .row {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .row .text,
    .row .media {
      grid-area: auto;
      justify-self: start;
    }

    :global(.variant-cards) .row,
    :global(.variant-cards) .row.flip {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      background: var(--ui-feature-card-fill, transparent);
    }

    :global(.variant-cards) .text {
      margin-bottom: 0;
    }

    :global(.variant-cards) .row .media {
      justify-self: stretch;
    }

    :global(.variant-cards) .media :global(.img) {
      width: 100%;
    }
  }

  @media (max-width: 767px) {
    .title {
      font-size: var(--ui-size-title);
    }

    .lead {
      font-size: var(--ui-size-small);
      font-weight: var(--ui-font-weight-heading);
    }

    .body {
      font-size: var(--ui-size-small);
    }

    :global(.variant-cards) .title {
      font-size: var(--ui-size-title-sm);
    }

    :global(.variant-cards) .body {
      font-size: var(--ui-size-small);
    }
  }

  @media (max-width: 479px) {
    :global(.variant-cards) .row {
      padding: 1.5rem 1.5rem 0;
    }

    :global(.variant-cards) .text {
      gap: 1rem;
    }
  }
</style>
