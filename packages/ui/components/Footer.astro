---
/**
 * Site footer: logo, contact email, socials, "Launched with Hyper", copyright
 * + legal links, and the portfolio credit line.
 *
 * layout   split (default): a deep panel; logo, email and socials on the left,
 *          "Launched with Hyper" and its blurb on the right.
 *          card: a dark card (--ui-bg-footer, --ui-radius-footer); logo and
 *          email on the left, "Launched with Hyper" over the socials on the
 *          right, no blurb unless `hyperText` is given. With `frame` the card
 *          sits in a light frame (--ui-bg-footer-frame, --ui-radius-footer-frame)
 *          that can continue the section above it.
 * variant  landing | legal — the legal pages break the Hyper blurb onto two
 *          lines and keep the copyright left-aligned on small screens.
 * reveal   the card rises into view (card layout).
 * Default slot: content inside the card above the footer rows (e.g. a CTA panel).
 * Legal links are separated by --ui-footer-legal-separator (e.g. '|'), if set.
 */
import type { ImageMetadata } from 'astro';
import SocialLinks, { type SocialLink } from './SocialLinks.astro';
import defaultHyperLogo from '../assets/hyper.svg';

interface LegalLink {
  href: string;
  label: string;
}

interface Props {
  logo: ImageMetadata;
  logoAlt: string;
  email?: string;
  /** Text before the email address. */
  emailLabel?: string;
  socials?: SocialLink[];
  copyright: string;
  legalLinks?: LegalLink[];
  /** Path of the current page, marks the matching legal link. */
  current?: string;
  variant?: 'landing' | 'legal';
  layout?: 'split' | 'card';
  frame?: boolean;
  reveal?: boolean;
  /** The Hyper blurb, one entry per sentence. */
  hyperText?: string[];
  /** A site's own version of the Hyper wordmark (white on dark). */
  hyperLogo?: ImageMetadata;
}

const {
  logo,
  logoAlt,
  email,
  emailLabel = 'Email :',
  socials,
  copyright,
  legalLinks = [],
  current,
  variant = 'landing',
  layout = 'split',
  frame = false,
  reveal = false,
  hyperLogo = defaultHyperLogo,
} = Astro.props;
const card = layout === 'card';
const hyperText =
  Astro.props.hyperText ??
  (card
    ? []
    : ['The best way to fund and launch your app.', 'Accelerate Process has helped 1,528 founders raise over $482 million since 2015.']);
const isLegal = variant === 'legal';
---

<footer class:list={['footer', `layout-${layout}`, `variant-${variant}`, { framed: card && frame }]}>
  <div class="container" {...(card && reveal ? { 'data-reveal': 'up' } : {})}>
    <slot />
    <div class="top">
      <div class="brand">
        <img class="logo" src={logo.src} width={logo.width} height={logo.height} alt={logoAlt} loading="lazy" />
        {
          email && (
            <p class="email">
              {emailLabel} <a href={`mailto:${email}`}>{email}</a>
            </p>
          )
        }
        {!card && socials?.length ? <SocialLinks links={socials} /> : null}
      </div>
      <div class="hyper">
        <p class="launched">
          <span>Launched with</span>
          <a href="https://www.hyperhq.com/" target="_blank" rel="noopener" aria-label="Hyper">
            <img src={hyperLogo.src} width={hyperLogo.width} height={hyperLogo.height} alt="" loading="lazy" />
          </a>
        </p>
        {
          hyperText.length > 0 && (
            <p class="hyper-text">{isLegal ? hyperText.map((line, i) => (i ? [<br />, line] : line)) : hyperText.join(' ')}</p>
          )
        }
        {card && socials?.length ? <SocialLinks links={socials} sizeSmall={24} /> : null}
      </div>
    </div>
    <div class="bottom">
      <p class="copyright">{copyright}</p>
      {
        legalLinks.length > 0 && (
          <ul class="legal">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <p class="credit">Portfolio rebuild by noirvision — original built in Webflow for Hyper.</p>
  </div>
</footer>

<style>
  .footer.layout-split {
    margin: var(--ui-panel-gap) var(--ui-panel-gap) 0;
    padding: 62px 0 1.4375rem;
    border-radius: var(--ui-radius-panel);
    background: var(--ui-bg-deep);
    color: var(--ui-color-on-deep);
  }

  .layout-split .container {
    max-width: var(--ui-container-max);
    margin-inline: auto;
    padding-inline: var(--ui-container-pad);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .layout-split .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-bottom: 108px;
    border-bottom: 1px solid var(--ui-color-divider-footer);
  }

  .layout-split .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 500px;
    max-width: 100%;
  }

  .layout-split .logo {
    display: block;
    margin-bottom: 12px;
  }

  .layout-split .email {
    margin-bottom: 12px;
    font-size: var(--ui-size-small);
  }

  .layout-split .hyper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .layout-split .launched {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 12px;
  }

  .layout-split .launched span {
    margin-right: 10px;
    font-size: 20px;
    font-weight: var(--ui-font-weight-heading);
    line-height: 24px;
  }

  .layout-split .launched img {
    display: block;
  }

  .layout-split .hyper-text {
    max-width: 380px;
    font-size: var(--ui-size-small);
    text-align: right;
  }

  .layout-split .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .layout-split .copyright {
    font-size: var(--ui-size-small);
  }

  .layout-split .legal {
    display: flex;
    flex: none;
    gap: 34px;
    align-items: center;
    justify-content: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.2;
  }

  .layout-split .legal a:hover {
    text-decoration: underline;
  }

  .layout-split .credit {
    margin-top: 1.5rem;
    color: var(--ui-color-on-strong-muted);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 991px) {
    .footer.layout-split {
      padding-top: 60px;
    }

    .layout-split .top {
      flex-direction: column;
      align-items: center;
      padding-bottom: 64px;
    }

    .layout-split .brand {
      align-items: center;
      margin-bottom: 20px;
    }

    .layout-split .hyper {
      align-items: center;
    }

    .layout-split .launched {
      align-items: center;
      justify-content: flex-start;
      margin-bottom: 9px;
    }

    .layout-split .hyper-text {
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .footer.layout-split {
      padding-bottom: 40px;
    }

    .layout-split .brand {
      margin-bottom: 1.5rem;
    }

    .layout-split .launched {
      justify-content: center;
    }

    .layout-split .launched span {
      font-size: 18px;
    }

    .layout-split .hyper-text {
      max-width: 350px;
      font-size: 14px;
    }

    .layout-split .bottom {
      flex-direction: column;
    }

    .layout-split .legal {
      flex-direction: column;
      gap: 34px;
      margin-bottom: 10px;
    }

    .layout-split .legal li {
      margin-bottom: 10px;
    }
  }

  @media (max-width: 479px) {
    .footer.layout-split {
      padding: 40px 0 24px;
    }

    .layout-split .container {
      padding-inline: var(--ui-container-pad-sm);
    }

    .layout-split .top {
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .layout-split .brand {
      width: 100%;
      margin-bottom: 0;
    }

    .layout-split .logo {
      margin-bottom: 40px;
    }

    .layout-split .email,
    .layout-split .copyright {
      margin-bottom: 1.5rem;
    }

    .layout-split .launched {
      margin-top: 20px;
    }

    .layout-split.variant-landing .copyright {
      text-align: center;
    }

    .layout-split .legal {
      flex-direction: row;
      margin-bottom: 0;
      font-size: 16px;
    }
  }
  /* Separator between legal links, drawn only if a site sets one. */
  .legal li + li::before {
    content: var(--ui-footer-legal-separator, none) / '';
    padding-inline: 10px;
    color: var(--ui-color-footer-separator, currentColor);
    opacity: 0.7;
  }

  /* ---------- Card layout ---------- */
  .footer.layout-card {
    margin: var(--ui-margin-footer, var(--ui-panel-gap));
    color: var(--ui-color-on-deep);
  }

  .footer.framed {
    margin: 0 var(--ui-panel-gap-x) var(--ui-page-pad-bottom);
    padding: 0 var(--ui-footer-frame-pad, 1.25rem) var(--ui-footer-frame-pad, 1.25rem);
    border-radius: var(--ui-radius-footer-frame, 0);
    background: var(--ui-bg-footer-frame, none);
    color: var(--ui-color-on-deep);
  }

  .layout-card .container {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: var(--ui-radius-footer, var(--ui-radius-panel));
    background: var(--ui-bg-footer, var(--ui-bg-deep));
  }

  .layout-card .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--ui-color-divider-footer);
  }

  .layout-card .brand {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
  }

  .layout-card .logo {
    display: block;
    margin-bottom: 1.5rem;
  }

  .layout-card .email {
    font-size: var(--ui-size-small);
    line-height: 1.2;
  }

  .layout-card .email a {
    font-size: var(--ui-font-size-body);
    letter-spacing: 0.02em;
    text-decoration: underline;
  }

  .layout-card .hyper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .layout-card .launched {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .layout-card .launched span {
    margin-right: 0.5rem;
    font-size: 18px;
    font-weight: var(--ui-footer-launched-weight, 400);
    letter-spacing: 0.2px;
    line-height: 1.3;
  }

  .layout-card .launched img {
    display: block;
  }

  .layout-card .hyper-text {
    max-width: 380px;
    margin-bottom: 1.5rem;
    font-size: var(--ui-size-small);
    text-align: right;
  }

  .layout-card .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .layout-card .copyright {
    font-size: var(--ui-size-small);
  }

  .layout-card .legal {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--ui-size-small);
    line-height: 1.5;
  }

  .layout-card .legal a:hover {
    text-decoration: underline;
  }

  .layout-card .credit {
    margin-top: 1rem;
    color: var(--ui-color-on-strong-muted);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 991px) {
    .layout-card .top {
      flex-direction: column;
      align-items: center;
    }

    .layout-card .brand {
      align-items: center;
      margin-bottom: 60px;
    }

    .layout-card .hyper {
      align-items: center;
    }

    .layout-card .hyper-text {
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    /* The rows shrink to their content, so the divider spans only that width. */
    .layout-card .top,
    .layout-card .bottom {
      align-self: center;
    }

    .layout-card .legal {
      justify-content: center;
      margin-bottom: 20px;
    }
  }

  @media (max-width: 479px) {
    .footer.framed {
      padding-inline: var(--ui-footer-frame-pad-small, 0.75rem);
    }

    .layout-card .container {
      padding: 8px;
      border-radius: var(--ui-radius-footer-small, var(--ui-radius-footer, var(--ui-radius-panel)));
    }

    .layout-card .launched span {
      font-size: 14px;
    }

    .layout-card .bottom {
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }

    .layout-card .copyright {
      text-align: center;
    }

    .layout-card .legal {
      margin-bottom: 0;
    }
  }
</style>
