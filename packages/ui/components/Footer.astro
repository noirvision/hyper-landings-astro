---
/**
 * Site footer on a deep panel: logo, contact email and socials on the left,
 * "Launched with Hyper" on the right, copyright + legal links below, and the
 * portfolio credit line.
 *
 * variant  landing | legal — the legal pages break the Hyper blurb onto two
 *          lines and keep the copyright left-aligned on small screens.
 */
import type { ImageMetadata } from 'astro';
import SocialLinks, { type SocialLink } from './SocialLinks.astro';
import hyperLogo from '../assets/hyper.svg';

interface LegalLink {
  href: string;
  label: string;
}

interface Props {
  logo: ImageMetadata;
  logoAlt: string;
  email?: string;
  socials?: SocialLink[];
  copyright: string;
  legalLinks?: LegalLink[];
  /** Path of the current page, marks the matching legal link. */
  current?: string;
  variant?: 'landing' | 'legal';
  /** The Hyper blurb, one entry per sentence. */
  hyperText?: string[];
}

const {
  logo,
  logoAlt,
  email,
  socials,
  copyright,
  legalLinks = [],
  current,
  variant = 'landing',
  hyperText = [
    'The best way to fund and launch your app.',
    'Accelerate Process has helped 1,528 founders raise over $482 million since 2015.',
  ],
} = Astro.props;
const isLegal = variant === 'legal';
---

<footer class:list={['footer', `variant-${variant}`]}>
  <div class="container">
    <div class="top">
      <div class="brand">
        <img class="logo" src={logo.src} width={logo.width} height={logo.height} alt={logoAlt} loading="lazy" />
        {
          email && (
            <p class="email">
              Email : <a href={`mailto:${email}`}>{email}</a>
            </p>
          )
        }
        {socials?.length ? <SocialLinks links={socials} /> : null}
      </div>
      <div class="hyper">
        <p class="launched">
          <span>Launched with</span>
          <a href="https://www.hyperhq.com/" target="_blank" rel="noopener" aria-label="Hyper">
            <img src={hyperLogo.src} width={hyperLogo.width} height={hyperLogo.height} alt="" loading="lazy" />
          </a>
        </p>
        <p class="hyper-text">
          {isLegal ? hyperText.map((line, i) => (i ? [<br />, line] : line)) : hyperText.join(' ')}
        </p>
      </div>
    </div>
    <div class="bottom">
      <p class="copyright">{copyright}</p>
      {
        legalLinks.length > 0 && (
          <ul class="legal">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <p class="credit">Portfolio rebuild by noirvision — original built in Webflow for Hyper.</p>
  </div>
</footer>

<style>
  .footer {
    margin: var(--ui-panel-gap) var(--ui-panel-gap) 0;
    padding: 62px 0 1.4375rem;
    border-radius: var(--ui-radius-panel);
    background: var(--ui-bg-deep);
    color: var(--ui-color-on-deep);
  }

  .container {
    max-width: var(--ui-container-max);
    margin-inline: auto;
    padding-inline: var(--ui-container-pad);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-bottom: 108px;
    border-bottom: 1px solid var(--ui-color-divider-footer);
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 500px;
    max-width: 100%;
  }

  .logo {
    display: block;
    margin-bottom: 12px;
  }

  .email {
    margin-bottom: 12px;
    font-size: var(--ui-size-small);
  }

  .hyper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .launched {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    margin-bottom: 12px;
  }

  .launched span {
    margin-right: 10px;
    font-size: 20px;
    font-weight: var(--ui-font-weight-heading);
    line-height: 24px;
  }

  .launched img {
    display: block;
  }

  .hyper-text {
    max-width: 380px;
    font-size: var(--ui-size-small);
    text-align: right;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .copyright {
    font-size: var(--ui-size-small);
  }

  .legal {
    display: flex;
    flex: none;
    gap: 34px;
    align-items: center;
    justify-content: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.2;
  }

  .legal a:hover {
    text-decoration: underline;
  }

  .credit {
    margin-top: 1.5rem;
    color: var(--ui-color-on-strong-muted);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 991px) {
    .footer {
      padding-top: 60px;
    }

    .top {
      flex-direction: column;
      align-items: center;
      padding-bottom: 64px;
    }

    .brand {
      align-items: center;
      margin-bottom: 20px;
    }

    .hyper {
      align-items: center;
    }

    .launched {
      align-items: center;
      justify-content: flex-start;
      margin-bottom: 9px;
    }

    .hyper-text {
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .footer {
      padding-bottom: 40px;
    }

    .brand {
      margin-bottom: 1.5rem;
    }

    .launched {
      justify-content: center;
    }

    .launched span {
      font-size: 18px;
    }

    .hyper-text {
      max-width: 350px;
      font-size: 14px;
    }

    .bottom {
      flex-direction: column;
    }

    .legal {
      flex-direction: column;
      gap: 34px;
      margin-bottom: 10px;
    }

    .legal li {
      margin-bottom: 10px;
    }
  }

  @media (max-width: 479px) {
    .footer {
      padding: 40px 0 24px;
    }

    .container {
      padding-inline: var(--ui-container-pad-sm);
    }

    .top {
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .brand {
      width: 100%;
      margin-bottom: 0;
    }

    .logo {
      margin-bottom: 40px;
    }

    .email,
    .copyright {
      margin-bottom: 1.5rem;
    }

    .launched {
      margin-top: 20px;
    }

    .variant-landing .copyright {
      text-align: center;
    }

    .legal {
      flex-direction: row;
      margin-bottom: 0;
      font-size: 16px;
    }
  }
</style>
