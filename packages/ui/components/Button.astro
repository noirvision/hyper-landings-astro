---
/**
 * Primary button (or link styled as one).
 *
 * Height and radius read --ui-button-height / --ui-button-radius, so a parent
 * component (or a site theme) can size it without touching its internals.
 * Also --ui-button-font-size, and the hover effect --ui-button-hover-filter /
 * --ui-button-hover-opacity with --ui-button-transition.
 *
 * variant  primary (accent fill) | inverse (light fill, accent text — for
 *          accent/deep panels).
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = { variant?: 'primary' | 'inverse' };
type Props = ((HTMLAttributes<'button'> & { href?: undefined }) | (HTMLAttributes<'a'> & { href: string })) & Variant;

const { href, class: className, variant = 'primary', ...attrs } = Astro.props as HTMLAttributes<'button'> & { href?: string } & Variant;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={['button', `variant-${variant}`, className]} {...(href ? {} : { type: 'button' })} {...attrs}><slot /></Tag>

<style>
  .button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    height: var(--ui-button-height, auto);
    padding: var(--ui-button-pad-y, 0.5625rem) var(--ui-button-pad-x, 1.5rem);
    border: 0;
    border-radius: var(--ui-button-radius, var(--ui-radius-button));
    background: var(--ui-color-accent);
    color: var(--ui-color-on-accent);
    font-size: var(--ui-button-font-size, var(--ui-size-small));
    font-weight: var(--ui-button-weight, var(--ui-font-weight-button));
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;
    transition: var(--ui-button-transition, filter 0.2s ease);
  }

  .variant-inverse {
    background: var(--ui-color-on-accent);
    color: var(--ui-color-accent);
  }

  .button:hover {
    filter: var(--ui-button-hover-filter, brightness(1.08));
    opacity: var(--ui-button-hover-opacity, 1);
  }

  @media (max-width: 767px) {
    .button {
      width: var(--ui-button-width-mobile, auto);
      height: var(--ui-button-height-mobile, var(--ui-button-height, auto));
      border-radius: var(--ui-button-radius-mobile, var(--ui-button-radius, var(--ui-radius-button)));
    }
  }
</style>
