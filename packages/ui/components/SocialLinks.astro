---
/**
 * Row of icon links to social profiles. Icons are site assets (SVG imports).
 */
import type { ImageMetadata } from 'astro';

export interface SocialLink {
  href: string;
  label: string;
  icon: ImageMetadata;
}

interface Props {
  links: SocialLink[];
  /** Icon size in px (desktop). */
  size?: number;
  /** Icon size in px at ≤479px. */
  sizeSmall?: number;
  class?: string;
  [key: `data-${string}`]: string;
}

const { links, size = 32, sizeSmall = size, class: className, ...attrs } = Astro.props;
---

<ul class:list={['socials', className]} style={`--_s:${size}px;--_s-sm:${sizeSmall}px`} {...attrs}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener" aria-label={link.label}>
          <img src={link.icon.src} width={size} height={size} alt="" loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.8;
  }

  img {
    display: block;
    width: var(--_s);
    height: var(--_s);
  }

  @media (max-width: 479px) {
    img {
      width: var(--_s-sm);
      height: var(--_s-sm);
    }
  }
</style>
