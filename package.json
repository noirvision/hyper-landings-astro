{
  "name": "hyper-landings-astro",
  "private": true,
  "type": "module",
  "description": "Hyper landing pages rebuilt in Astro on one shared component library.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev:oddacademia": "npm run dev -w @noirvision/site-oddacademia",
    "build:oddacademia": "npm run build -w @noirvision/site-oddacademia",
    "preview:oddacademia": "npm run preview -w @noirvision/site-oddacademia",
    "dev:policybox": "npm run dev -w @noirvision/site-policybox",
    "build:policybox": "npm run build -w @noirvision/site-policybox",
    "preview:policybox": "npm run preview -w @noirvision/site-policybox",
    "dev:rithm": "npm run dev -w @noirvision/site-rithm",
    "build:rithm": "npm run build -w @noirvision/site-rithm",
    "preview:rithm": "npm run preview -w @noirvision/site-rithm",
    "build": "npm run build --workspaces --if-present"
  }
}
